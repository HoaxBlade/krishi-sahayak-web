# Multi-Model Dockerfile for Krishi Sahayak
FROM python:3.11-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y \
    curl \
    libgl1-mesa-dev \
    libglib2.0-0 \
    libsm6 \
    libxext6 \
    libxrender-dev \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# Environment variables
ENV PYTHONUNBUFFERED=1
ENV TENSORFLOW_CPP_MIN_LOG_LEVEL=2
ENV FLASK_PORT=5000
ENV FLASK_HOST=0.0.0.0

# Copy requirements and install Python packages
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy all model files and scripts
COPY . .

# Create directories for models and logs
RUN mkdir -p saved_models logs

# Copy all model files (both .h5 and .tflite)
COPY saved_models/ saved_models/
COPY model/ model/

# Create non-root user
RUN useradd -m -u 1000 appuser
USER appuser

EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -fsS http://localhost:5000/health || exit 1

# Run the multi-model server
CMD ["python3", "main_production_multi.py"]
